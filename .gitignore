# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# e2e（Playwright 产物 + 测试用户登录态）
/e2e-results/
/playwright-report/
/.e2e/

# next.js
/.next/
/.next-prod/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 数据库（数据库迁移方案：dev.db 永久保留为本地备份，不提交）
prisma/dev.db
prisma/*.db
prisma/dev.db.*
# 本地便携 PostgreSQL（迁移工具，不入库）
/.pg-local/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# 调试残留（禁止提交）
/*.log
/scripts/tmp-*.py
/repro-*.py
/mdcheck*.py
/retest-*.js
/re-test-*.js
/test-drag.mjs
/test-results/

.vercel
.env*

# 本地启动器日志（不入库）
/meridian-launcher.log
/meridian-dev.log
/meridian-dev.pid
